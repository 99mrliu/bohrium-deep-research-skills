{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-deck-transaction plan (semantic invariants are enforced by run_case.py)",
  "type": "object",
  "required": ["schema_version", "mode", "base_path", "base_slide_ids", "meta", "operations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["adapt", "edit", "generate"]},
    "base_path": {"type": "string", "minLength": 1},
    "base_slide_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "meta": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "audience": {"type": ["string", "null"]},
        "minutes": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "slide_count": {"type": ["integer", "null"], "minimum": 1},
        "minimum_explicit_font_pt": {"type": "number", "exclusiveMinimum": 0},
        "visual_review": {"type": "object"}
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {"enum": ["keep", "edit", "append", "remove", "reorder"]},
          "id": {"type": "string"},
          "source_slide_id": {"type": "string"},
          "layout": {"type": "string"},
          "layout_idx": {"type": "integer", "minimum": 0},
          "title": {"type": "string"},
          "bullets": {
            "type": "array",
            "items": {
              "anyOf": [
                {"type": "string"},
                {"type": "object", "properties": {"text": {"type": "string"}, "level": {"type": "integer", "minimum": 0, "maximum": 8}}}
              ]
            }
          },
          "title_placeholder_idx": {"type": "integer", "minimum": 0},
          "body_placeholder_idx": {"type": "integer", "minimum": 0},
          "notes": {"type": "string"},
          "presentation_metadata": {"type": "boolean"},
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string"},
                "source_id": {"type": "string"},
                "page": {"type": "integer", "minimum": 1},
                "extracted_image_index": {"type": "integer", "minimum": 0},
                "placeholder_idx": {"type": "integer", "minimum": 0},
                "figure": {"type": "string"}
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "page", "quote"],
              "properties": {
                "source_id": {"type": "string"},
                "page": {"type": "integer", "minimum": 1},
                "quote_id": {"type": "string"},
                "quote": {"type": "string", "minLength": 1},
                "section": {"type": "string"},
                "figure": {"type": "string"}
              }
            }
          },
          "final_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
