{"id": "S0006", "offset": 246, "section": "front_matter", "text": "Effects of Compound X on Seedling Growth: A Controlled Pot Trial"}
{"id": "S0007", "offset": 312, "section": "abstract", "text": "Abstract"}
{"id": "S0008", "offset": 321, "section": "abstract", "text": "We tested whether Compound X changes seedling height."}
{"id": "S0009", "offset": 374, "section": "abstract", "text": "Forty pots were"}
{"id": "S0010", "offset": 391, "section": "abstract", "text": "randomized to control or treatment."}
{"id": "S0011", "offset": 426, "section": "abstract", "text": "Treated seedlings were taller on"}
{"id": "S0012", "offset": 460, "section": "abstract", "text": "average."}
{"id": "S0013", "offset": 468, "section": "abstract", "text": "We discuss implications for greenhouse practice."}
{"id": "S0014", "offset": 521, "section": "introduction", "text": "Introduction"}
{"id": "S0015", "offset": 535, "section": "introduction", "text": "Compound X is widely used in horticulture."}
{"id": "S0016", "offset": 577, "section": "introduction", "text": "Whether it improves early"}
{"id": "S0017", "offset": 604, "section": "introduction", "text": "growth remains contested."}
{"id": "S0018", "offset": 629, "section": "introduction", "text": "This study asks: does Compound X increase"}
{"id": "S0019", "offset": 672, "section": "introduction", "text": "seedling height under controlled conditions?"}
{"id": "S0020", "offset": 720, "section": "methods", "text": "Methods"}
{"id": "S0021", "offset": 729, "section": "methods", "text": "Forty pots were randomized, twenty per arm."}
{"id": "S0022", "offset": 772, "section": "methods", "text": "Height was measured at day 21"}
{"id": "S0023", "offset": 803, "section": "methods", "text": "by a blinded rater."}
{"id": "S0024", "offset": 822, "section": "methods", "text": "The significance threshold was p < 0.05."}
{"id": "S0025", "offset": 867, "section": "results", "text": "Results"}
{"id": "S0026", "offset": 876, "section": "results", "text": "Mean height was 12.4 cm in the control arm and 15.1 cm in the treatment"}
{"id": "S0027", "offset": 948, "section": "results", "text": "arm."}
{"id": "S0028", "offset": 952, "section": "results", "text": "The difference was statistically significant (p = 0.03)."}
{"id": "S0029", "offset": 1013, "section": "discussion", "text": "Discussion"}
{"id": "S0030", "offset": 1025, "section": "discussion", "text": "Compound X increased seedling height under these conditions."}
{"id": "S0031", "offset": 1085, "section": "discussion", "text": "The effect"}
{"id": "S0032", "offset": 1097, "section": "discussion", "text": "may not generalize to field soils."}
{"id": "S0033", "offset": 1131, "section": "discussion", "text": "Limitations include the short"}
{"id": "S0034", "offset": 1162, "section": "discussion", "text": "follow-up and the single cultivar."}
