          },
          {
            "paragraph_id": "p-b-1",
            "quote": "spiro-OMeTAD作为空穴传输材料",
            "source_id": "S2"
          }
        ],
        "id": "m2",
        "left": "S1「spiro-OMeTAD空穴传输层」(p-a-2)",
        "rationale": "同名材料、同一角色（空穴传输），跨篇合并；各自证据保留来源。",
        "right": "S2「spiro-OMeTAD作为空穴传输材料」(p-b-1)"
      },
      {
        "canonical_node": null,
        "decision": "no_merge",
        "evidence": [
          {
