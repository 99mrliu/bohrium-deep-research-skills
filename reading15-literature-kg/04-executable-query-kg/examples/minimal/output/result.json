          }
        ],
        "id": "m5",
        "left": "n:pce（光电转换效率18.5%，S1 样品A）",
        "rationale": "不同指标、不同数值、不同实验条件；禁止把两篇的数值结果合成一个结论。",
        "right": "n:stability（100小时后90%保持率，S2 样品B）"
      }
    ],
