{
  "version": "1.0.0",
  "description": "Machine-readable unit and prefix rule table for scripts/quantity_ledger.py. factors convert a value to the SI base of its dimensions: base = raw * factor + offset (offset only for affine absolute temperature). factor_num/factor_den express exact rational definitions; is_exact=false marks conventional/approximate decimal definitions. All arithmetic is Decimal.",
  "dimensions": {"L": "length (m)", "M": "mass (kg)", "T": "time (s)", "I": "current (A)", "Th": "thermodynamic temperature (K)", "N": "amount of substance (mol)"},
  "prefixes": {
    "Y": {"power": 24, "id": "P.yotta"}, "Z": {"power": 21, "id": "P.zetta"},
    "E": {"power": 18, "id": "P.exa"}, "P": {"power": 15, "id": "P.peta"},
    "T": {"power": 12, "id": "P.tera"}, "G": {"power": 9, "id": "P.giga"},
    "M": {"power": 6, "id": "P.mega"}, "k": {"power": 3, "id": "P.kilo"},
    "h": {"power": 2, "id": "P.hecto"}, "da": {"power": 1, "id": "P.deca"},
    "d": {"power": -1, "id": "P.deci"}, "c": {"power": -2, "id": "P.centi"},
    "m": {"power": -3, "id": "P.milli"}, "u": {"power": -6, "id": "P.micro"},
    "µ": {"power": -6, "id": "P.micro"}, "μ": {"power": -6, "id": "P.micro"},
    "n": {"power": -9, "id": "P.nano"}, "p": {"power": -12, "id": "P.pico"},
    "f": {"power": -15, "id": "P.femto"}, "a": {"power": -18, "id": "P.atto"}
  },
  "ambiguous_symbols": {
    "C": "coulomb (U.C) vs degrees Celsius (U.degC): bare 'C' is never auto-converted; use '°C'/'degC' or 'C' only in an electrical context after manual confirmation",
    "ppt": "parts per thousand vs parts per trillion: use ppth (thousand) or pptn (trillion); bare 'ppt' goes to review"
  },
  "units": [
    {"id": "U.m", "symbols": ["m", "meter", "meters", "metre", "metres"], "factor": "1", "dims": {"L": 1}, "prefixable": true, "is_exact": true, "name": "metre"},
    {"id": "U.kg", "symbols": ["kg", "kilogram", "kilograms"], "factor": "1", "dims": {"M": 1}, "prefixable": false, "is_exact": true, "name": "kilogram"},
    {"id": "U.g", "symbols": ["g", "gram", "grams"], "factor": "0.001", "dims": {"M": 1}, "prefixable": true, "is_exact": true, "name": "gram"},
    {"id": "U.tonne", "symbols": ["tonne", "t", "Mg"], "factor": "1000", "dims": {"M": 1}, "prefixable": false, "is_exact": true, "name": "tonne"},
    {"id": "U.s", "symbols": ["s", "sec", "second", "seconds"], "factor": "1", "dims": {"T": 1}, "prefixable": true, "is_exact": true, "name": "second"},
    {"id": "U.min", "symbols": ["min", "minute", "minutes"], "factor": "60", "dims": {"T": 1}, "prefixable": false, "is_exact": true, "name": "minute"},
    {"id": "U.h", "symbols": ["h", "hr", "hour", "hours"], "factor": "3600", "dims": {"T": 1}, "prefixable": false, "is_exact": true, "name": "hour"},
    {"id": "U.d", "symbols": ["d", "day", "days"], "factor": "86400", "dims": {"T": 1}, "prefixable": false, "is_exact": true, "name": "day"},
    {"id": "U.wk", "symbols": ["wk", "week", "weeks"], "factor": "604800", "dims": {"T": 1}, "prefixable": false, "is_exact": true, "name": "week"},
    {"id": "U.yr", "symbols": ["yr", "year", "years", "julioryear"], "factor": "31557600", "dims": {"T": 1}, "prefixable": false, "is_exact": true, "name": "Julian year (365.25 d), exact by definition; calendar years are not fixed durations"},
    {"id": "U.A", "symbols": ["A", "ampere", "amp"], "factor": "1", "dims": {"I": 1}, "prefixable": true, "is_exact": true, "name": "ampere"},
    {"id": "U.K", "symbols": ["K", "kelvin"], "factor": "1", "offset": "0", "dims": {"Th": 1}, "prefixable": true, "is_exact": true, "name": "kelvin"},
    {"id": "U.degC", "symbols": ["°C", "degC", "celsius"], "kind": "affine", "factor": "1", "offset": "273.15", "dims": {"Th": 1}, "prefixable": false, "is_exact": true, "name": "degree Celsius", "formula": "T[K] = T[°C] * 1 + 273.15 ; differences: ΔT[K] = ΔT[°C]"},
    {"id": "U.degF", "symbols": ["°F", "degF", "fahrenheit"], "kind": "affine", "factor_num": "5", "factor_den": "9", "offset_num": "2298.35", "offset_den": "9", "dims": {"Th": 1}, "prefixable": false, "is_exact": true, "name": "degree Fahrenheit", "formula": "T[K] = T[°F] * 5/9 + 2298.35/9 (i.e. (T[°F] + 459.67) * 5/9)"},
    {"id": "U.mol", "symbols": ["mol", "mole", "moles"], "factor": "1", "dims": {"N": 1}, "prefixable": true, "is_exact": true, "name": "mole"},
    {"id": "U.L", "symbols": ["L", "l", "liter", "litre", "liters", "litres"], "factor": "0.001", "dims": {"L": 3}, "prefixable": true, "is_exact": true, "name": "litre (1 L = 0.001 m^3 exactly)"},
    {"id": "U.Pa", "symbols": ["Pa", "pascal"], "factor": "1", "dims": {"L": -1, "M": 1, "T": -2}, "prefixable": true, "is_exact": true, "name": "pascal"},
    {"id": "U.bar", "symbols": ["bar"], "factor": "100000", "dims": {"L": -1, "M": 1, "T": -2}, "prefixable": true, "is_exact": true, "name": "bar (10^5 Pa exactly)"},
    {"id": "U.atm", "symbols": ["atm", "atmosphere"], "factor": "101325", "dims": {"L": -1, "M": 1, "T": -2}, "prefixable": false, "is_exact": true, "name": "standard atmosphere (101325 Pa exactly)"},
    {"id": "U.Torr", "symbols": ["Torr", "torr"], "factor_num": "101325", "factor_den": "760", "dims": {"L": -1, "M": 1, "T": -2}, "prefixable": false, "is_exact": true, "name": "torr (atm/760 exactly)"},
    {"id": "U.mmHg", "symbols": ["mmHg"], "factor": "133.322387415", "dims": {"L": -1, "M": 1, "T": -2}, "prefixable": false, "is_exact": false, "name": "conventional millimetre of mercury (approx. 133.322387415 Pa)"},
    {"id": "U.psi", "symbols": ["psi"], "factor": "6894.757293168", "dims": {"L": -1, "M": 1, "T": -2}, "prefixable": false, "is_exact": false, "name": "pound-force per square inch (approx. 6894.757293168 Pa)"},
    {"id": "U.inHg", "symbols": ["inHg"], "factor": "3386.389", "dims": {"L": -1, "M": 1, "T": -2}, "prefixable": false, "is_exact": false, "name": "conventional inch of mercury (approx. 3386.389 Pa)"},
    {"id": "U.J", "symbols": ["J", "joule"], "factor": "1", "dims": {"L": 2, "M": 1, "T": -2}, "prefixable": true, "is_exact": true, "name": "joule"},
    {"id": "U.N", "symbols": ["N", "newton"], "factor": "1", "dims": {"L": 1, "M": 1, "T": -2}, "prefixable": true, "is_exact": true, "name": "newton"},
    {"id": "U.W", "symbols": ["W", "watt"], "factor": "1", "dims": {"L": 2, "M": 1, "T": -3}, "prefixable": true, "is_exact": true, "name": "watt"},
    {"id": "U.Hz", "symbols": ["Hz"], "factor": "1", "dims": {"T": -1}, "prefixable": true, "is_exact": true, "name": "hertz"},
    {"id": "U.V", "symbols": ["V", "volt"], "factor": "1", "dims": {"L": 2, "M": 1, "T": -3, "I": -1}, "prefixable": true, "is_exact": true, "name": "volt"},
    {"id": "U.C", "symbols": ["C", "coulomb"], "factor": "1", "dims": {"I": 1, "T": 1}, "prefixable": true, "is_exact": true, "name": "coulomb"},
    {"id": "U.eV", "symbols": ["eV"], "factor": "1.602176634e-19", "dims": {"L": 2, "M": 1, "T": -2}, "prefixable": true, "is_exact": true, "name": "electronvolt (2019 SI, exact)"},
    {"id": "U.cal", "symbols": ["cal", "cal_th", "calth"], "factor": "4.184", "dims": {"L": 2, "M": 1, "T": -2}, "prefixable": true, "is_exact": true, "name": "thermochemical calorie (4.184 J exactly)"},
    {"id": "U.cal_IT", "symbols": ["cal_IT", "calIT", "calit"], "factor": "4.1868", "dims": {"L": 2, "M": 1, "T": -2}, "prefixable": true, "is_exact": true, "name": "International Table calorie (4.1868 J exactly)"},
    {"id": "U.kcal_IT", "symbols": ["kcal_IT", "kcalIT"], "factor": "4186.8", "dims": {"L": 2, "M": 1, "T": -2}, "prefixable": false, "is_exact": true, "name": "International Table kilocalorie"},
    {"id": "U.Wh", "symbols": ["Wh"], "factor": "3600", "dims": {"L": 2, "M": 1, "T": -2}, "prefixable": true, "is_exact": true, "name": "watt hour (3600 J exactly)"},
    {"id": "U.Hartree", "symbols": ["Hartree", "Eh"], "factor": "4.3597447222071e-18", "dims": {"L": 2, "M": 1, "T": -2}, "prefixable": false, "is_exact": false, "name": "hartree (CODATA 2018 approx. 4.3597447222071e-18 J)"},
    {"id": "U.percent", "symbols": ["%"], "factor": "0.01", "dims": {}, "prefixable": false, "is_exact": true, "name": "percent (dimensionless 1e-2)"},
    {"id": "U.permille", "symbols": ["‰", "permille", "ppth"], "factor": "0.001", "dims": {}, "prefixable": false, "is_exact": true, "name": "per mille / parts per thousand"},
    {"id": "U.ppm", "symbols": ["ppm"], "factor": "1e-6", "dims": {}, "prefixable": false, "is_exact": true, "name": "parts per million (dimensionless; mass/molar concentration requires density/molar mass and is NOT auto-converted)"},
    {"id": "U.ppb", "symbols": ["ppb"], "factor": "1e-9", "dims": {}, "prefixable": false, "is_exact": true, "name": "parts per billion"},
    {"id": "U.pptn", "symbols": ["pptn"], "factor": "1e-12", "dims": {}, "prefixable": false, "is_exact": true, "name": "parts per trillion"},
    {"id": "U.rad", "symbols": ["rad"], "factor": "1", "dims": {}, "prefixable": true, "is_exact": true, "name": "radian (dimensionless)"}
  ],
  "default_targets": {
    "": "1",
    "L:1": "m", "L:2": "m^2", "L:3": "m^3",
    "M:1": "kg", "T:1": "s", "Th:1": "K", "N:1": "mol",
    "L:-1,M:1,T:-2": "Pa",
    "L:1,M:1,T:-2": "N",
    "L:2,M:1,T:-2": "J",
    "L:2,M:1,T:-3": "W",
    "T:-1": "Hz",
    "I:1,T:1": "A s",
    "L:2,I:-1,M:1,T:-3": "V",
    "L:-3,N:1": "mol m^-3",
    "L:-3,M:1": "kg m^-3",
    "L:2,M:1,N:-1,T:-2": "J mol^-1",
    "L:2,M:1,N:-1,T:-2,Th:-1": "J mol^-1 K^-1"
  },
  "precision_policy": "Decimal arithmetic at 80-digit guard precision; no significant-figure rounding is applied to converted values; if any step is inexact (e.g. Torr=101325/760) the ledger field rounded_inexact is true and the rendered digits must be treated as a precise-context approximation, never as exact."
}
