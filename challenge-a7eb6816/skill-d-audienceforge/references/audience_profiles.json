{
  "version": "1.0.0",
  "description": "受众画像库：audience_route.py 与 jargon_scan.py 从此文件路由。term_density_ceiling 为每百字行话命中数上限。",
  "audiences": {
    "public": {
      "label": "公众科普",
      "term_density_ceiling": 1.0,
      "abbreviation_policy": {
        "mode": "expand_all_first",
        "rule": "所有非白名单缩写在首次出现处必须写为「全称（缩写）」",
        "whitelist": ["DNA", "RNA", "ATP", "CO2"]
      },
      "analogy_policy": {
        "mode": "encourage",
        "rule": "每个核心概念至少配一个生活化类比，禁止公式与符号堆砌"
      },
      "structure_template": [
        "悬念或痛点引入",
        "一句话结论",
        "它是什么（生活化类比）",
        "科学家做了什么（无公式）",
        "结果怎么样（数字化但口语化）",
        "为什么重要（与读者生活的连接）"
      ],
      "length_guidance": "800–1200 字",
      "banned_expressions": ["赋能", "抓手", "颠覆性", "诺奖级"]
    },
    "grant_review": {
      "label": "项目评审",
      "term_density_ceiling": 3.0,
      "abbreviation_policy": {
        "mode": "expand_all_first",
        "rule": "专业缩写首次出现必须展开；常见方法学缩写可保留",
        "whitelist": ["DNA", "RNA", "ATP", "PCR", "CO2"]
      },
      "analogy_policy": {
        "mode": "limited",
        "rule": "仅在跨领域概念处使用类比，主体论述保持形式化"
      },
      "structure_template": [
        "研究背景与科学缺口",
        "研究目标与假设",
        "技术路线与方法",
        "创新点（与现有工作的差异）",
        "可行性与风险分析",
        "预期成果与考核指标"
      ],
      "length_guidance": "1500–3000 字",
      "banned_expressions": ["众所周知", "显而易见", "填补国内空白"]
    },
    "cross_discipline": {
      "label": "跨学科研究者",
      "term_density_ceiling": 2.0,
      "abbreviation_policy": {
        "mode": "expand_all_first",
        "rule": "本学科外的缩写首次出现必须展开并附一句话定义",
        "whitelist": ["DNA", "RNA", "ATP", "CO2"]
      },
      "analogy_policy": {
        "mode": "moderate",
        "rule": "关键术语配一句话定义加类比，类比须注明适用边界"
      },
      "structure_template": [
        "问题与领域背景（为何外领域读者应关心）",
        "核心发现（无公式表述）",
        "方法概述（伪代码级粒度）",
        "与其他领域的连接点",
        "局限与开放问题"
      ],
      "length_guidance": "1000–2000 字",
      "banned_expressions": ["显而易见", "显然可知"]
    },
    "bilingual_editor": {
      "label": "双语编辑",
      "term_density_ceiling": 2.5,
      "abbreviation_policy": {
        "mode": "expand_all_first",
        "rule": "中英两稿各自在首次出现处展开缩写，两稿缩写集合须一致",
        "whitelist": ["DNA", "RNA", "ATP", "CO2"]
      },
      "analogy_policy": {
        "mode": "inherit_source",
        "rule": "保持源文类比并检查目标语言的文化适配性"
      },
      "structure_template": [
        "术语对齐表（source_term → 批准译法）",
        "逐段对照翻译",
        "术语一致性复核（glossary_check --pair）"
      ],
      "length_guidance": "与源文等长 ±15%",
      "banned_expressions": ["机翻腔", "逐字硬译"]
    }
  },
  "fallback_profile": {
    "label": "保守默认（未知受众兜底）",
    "term_density_ceiling": 0.8,
    "abbreviation_policy": {
      "mode": "expand_all_first",
      "rule": "一切缩写首次出现必须展开，白名单从简",
      "whitelist": ["DNA", "RNA"]
    },
    "analogy_policy": {
      "mode": "encourage",
      "rule": "默认面向非专业读者，所有核心概念配类比"
    },
    "structure_template": [
      "一句话结论",
      "背景与问题",
      "做法（无公式）",
      "结果",
      "意义与局限"
    ],
    "length_guidance": "600–1000 字",
    "banned_expressions": ["赋能", "抓手", "颠覆性", "众所周知"]
  }
}
