        {
          "metric": "percentage_point_difference",
          "basis": "raw_counts",
          "source_ids": ["obs_treatment", "obs_control"],
          "target": {"value": 20, "unit": "percentage_point"},
          "tolerance": {"absolute": 1e-9, "relative": 0}
        },
        {
          "metric": "relative_change",
          "basis": "raw_counts",
          "source_ids": ["obs_treatment", "obs_control"],
          "target": {"value": 0.40, "unit": "relative_fraction"},
          "tolerance": {"absolute": 1e-9, "relative": 0}
        },
        {
          "metric": "proportion_ratio",
          "basis": "raw_counts",
          "source_ids": ["obs_treatment", "obs_control"],
          "target": {"value": 1.4, "unit": "ratio"},
          "tolerance": {"absolute": 1e-9, "relative": 0}
        }
      ]
    },
    {
      "id": "C2_DISPLAY_RELATIVE",
