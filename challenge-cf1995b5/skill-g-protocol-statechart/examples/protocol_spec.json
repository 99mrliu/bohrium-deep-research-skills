{
  "schema_version": "1.0",
  "protocol_id": "SYN-NO3-COLOR-STATECHART-01",
  "title": "合成水样比色硝酸盐测定：有限域优化与有界 QC 重试",
  "outcome_status": "hypothetical_unmeasured",
  "parameters": {
    "reaction_temperature": "30",
    "reaction_time": "20",
    "sample_matrix": "synthetic_freshwater"
  },
  "scientific_plan": {
    "hypotheses": [
      {
        "id": "H1",
        "statement": "在本合成方案中，选择 30 degC、20 min 的规划组合可在有效校准空白之后进入样品测定；该句仅描述可检验计划，不断言现实方法性能。",
        "falsification": "若现实经批准实验在空白有效后仍不满足预先登记的样品 QC 验收标准，则拒绝此规划组合的适用性假设并修订方案。"
      },
      {
        "id": "H2",
        "statement": "一次重新空白可能使合成高空白故障恢复到空白 QC 通过分支。",
        "falsification": "若重新空白后的受控实测仍不满足空白回收率守卫，则 H2 被该次故障处置路径证伪，流程必须进入 QC_FAIL，不得继续消耗样品。"
      }
    ],
    "variables": {
      "independent": [
        {"name": "reaction_temperature", "unit": "degC", "domain": "20..40 step 5"},
        {"name": "reaction_time", "unit": "min", "domain": "10..30 step 10"}
      ],
      "dependent": [
        {"name": "calibration_blank_recovery_percent", "unit": "%", "record": "run_log.blank_qc.recovery_percent"},
        {"name": "sample_response", "unit": "instrument_defined", "record": "run_log.sample.response"}
      ],
      "controlled": [
        "sample_matrix=synthetic_freshwater",
        "reagent lot and actual expiry to be recorded before execution",
        "calibration sequence and pipette SOP to be confirmed by method owner"
      ]
    },
    "controls": [
      {
        "id": "CTRL_BLANK",
        "type": "calibration_blank",
        "purpose": "在消耗样品前隔离高空白/背景故障",
        "procedure_states": ["S20_PREPARE_BLANK", "S30_MEASURE_BLANK", "D30_BLANK_QC"],
        "unmeasured": true
      },
      {
        "id": "CTRL_CALIBRATION",
        "type": "calibration_series",
        "purpose": "建立并记录合成规划中的校准系列；现实点数以批准 SOP 为准",
        "procedure_states": ["S40_PREPARE_CALIBRATION"],
        "unmeasured": true
      },
      {
        "id": "CTRL_FAIL_SAFE",
        "type": "negative_process_control",
        "purpose": "持续 QC 故障时阻止样品反应并终止",
        "procedure_states": ["T_QC_FAIL"],
        "unmeasured": true
      }
    ],
    "acceptance_criteria": [
      {
        "id": "AC_BLANK_RECOVERY",
        "metric": "calibration_blank_recovery_percent",
        "operator": "<=",
        "threshold": "105",
        "unit": "%",
        "record": "run_log.blank_qc.recovery_percent",
        "meaning": "合成规划阈值；不是从现实标准或实验数据取得的性能限值"
      },
      {
        "id": "AC_SAMPLE_RECORD",
        "metric": "sample_response_within_approved_calibration_range",
        "operator": "==",
        "threshold": "true",
        "unit": "boolean",
        "record": "run_log.sample.within_calibration_range",
        "meaning": "实际执行时的记录要求；本例没有注入样品测量结果，也不声称通过"
      }
    ],
    "risk_and_revisions": [
      {
        "risk": "高空白或背景异常",
        "detection": "D30_BLANK_QC 的 recovery_percent 与 reblank_attempt_count 记录",
        "revision": "允许一次 S35_REBLANK；持续故障进入 T_QC_FAIL，禁止绕过 QC",
        "residual_uncertainty": "未实测故障原因和恢复概率"
      },
      {
        "risk": "温度/时间候选越出有限域",
        "detection": "bootstrap 与 compile 的 Decimal min/max/step 审计",
        "revision": "拒绝候选并从 case 声明网格重选；不得用四舍五入掩盖越域",
        "residual_uncertainty": "有限域本身是合成输入，并非现实方法推荐"
      },
      {
        "risk": "试剂、仪器或人员资源与现实不符",
        "detection": "执行前资源负责人核对",
        "revision": "暂停执行并重新规划；当前状态成本/时长不是报价、预约或批准",
        "residual_uncertainty": "未确认实际库存、校准状态和价格"
      }
    ],
    "planning_evidence": [
      {
        "evidence_id": "PE1",
        "claim": "30 degC、20 min 和 105% 仅用于演示有限域与守卫执行",
        "source_type": "synthetic_planning_assumption",
        "citation": "examples/mock_case.json and examples/materials/assay_notes.txt",
        "measured": false
      },
      {
        "evidence_id": "PE2",
        "claim": "nominal、recoverable_high_blank、persistent_qc_failure 的决策序列全部是注入的 what-if 标签",
