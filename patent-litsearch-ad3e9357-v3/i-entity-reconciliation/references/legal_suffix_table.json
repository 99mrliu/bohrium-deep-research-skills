{
  "description": "Legal-suffix canonicalization table for rule R4 of name_norm.py. All 'forms' are matched AFTER case folding and punctuation stripping (rules R2/R3), so forms are written in their post-R3 surface shape (lowercase, no punctuation, tokens separated by single spaces). 'canonical' is the single token substituted into the normalized name. Matching is longest-form-first, one replacement per form entry, and a form is never matched when it would consume the entire name.",
  "version": "1.0",
  "canonical_suffixes": [
    {"canonical": "inc",      "forms": ["inc", "incorporated"],                                  "jurisdiction": "US/CA",          "note": "Incorporated."},
    {"canonical": "corp",     "forms": ["corp", "corporation"],                                  "jurisdiction": "US",             "note": "Corporation."},
    {"canonical": "co",       "forms": ["co", "company"],                                        "jurisdiction": "US/UK generic",  "note": "Ambiguous token; see normalization_rules.md risk note."},
    {"canonical": "ltd",      "forms": ["co ltd", "ltd", "limited", "有限公司"],                  "jurisdiction": "UK/CN/HK",       "note": "Private limited company; 'Co., Ltd.' normalizes to 'co ltd' before R4."},
    {"canonical": "llc",      "forms": ["llc", "limited liability company"],                     "jurisdiction": "US",             "note": "Limited liability company."},
    {"canonical": "llp",      "forms": ["llp", "limited liability partnership"],                 "jurisdiction": "US/UK",          "note": "Limited liability partnership."},
    {"canonical": "lp",       "forms": ["lp", "limited partnership"],                            "jurisdiction": "US/UK",          "note": "Limited partnership."},
    {"canonical": "plc",      "forms": ["plc", "public limited company"],                        "jurisdiction": "UK/IE",          "note": "Public limited company."},
    {"canonical": "gmbh",     "forms": ["gmbh", "gesellschaft mit beschränkter haftung"],        "jurisdiction": "DE/AT/CH",       "note": "German limited-liability company."},
    {"canonical": "ag",       "forms": ["ag", "aktiengesellschaft"],                             "jurisdiction": "DE/AT/CH",       "note": "Stock corporation; short token, risk noted in rules doc."},
    {"canonical": "kg",       "forms": ["kg", "kommanditgesellschaft"],                          "jurisdiction": "DE",             "note": "Limited partnership."},
    {"canonical": "gmbhcokg", "forms": ["gmbh co kg", "gmbh und co kg"],                         "jurisdiction": "DE",             "note": "'GmbH & Co. KG' -> 'gmbh co kg' after R3."},
    {"canonical": "ohg",      "forms": ["ohg", "offene handelsgesellschaft"],                    "jurisdiction": "DE",             "note": "General partnership."},
    {"canonical": "ug",       "forms": ["ug", "unternehmergesellschaft"],                        "jurisdiction": "DE",             "note": "Entrepreneurial company (mini-GmbH)."},
    {"canonical": "sa",       "forms": ["sa", "societe anonyme", "société anonyme", "sociedad anonima", "sociedad anónima", "sociedade anonima", "sociedade anônima"], "jurisdiction": "FR/ES/PT/CH/LatAm", "note": "Public limited company (Romance-language jurisdictions)."},
