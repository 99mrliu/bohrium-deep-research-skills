    {"canonical": "sarl",     "forms": ["sarl", "societe a responsabilite limitee", "société à responsabilité limitée"], "jurisdiction": "FR", "note": "Limited-liability company."},
    {"canonical": "spa",      "forms": ["spa", "societa per azioni", "società per azioni"],      "jurisdiction": "IT",             "note": "Joint-stock company."},
    {"canonical": "srl",      "forms": ["srl", "societa a responsabilita limitata", "società a responsabilità limitata", "sociedad de responsabilidad limitada"], "jurisdiction": "IT/ES", "note": "Limited-liability company."},
    {"canonical": "bv",       "forms": ["bv", "besloten vennootschap"],                          "jurisdiction": "NL/BE",          "note": "Private limited company."},
