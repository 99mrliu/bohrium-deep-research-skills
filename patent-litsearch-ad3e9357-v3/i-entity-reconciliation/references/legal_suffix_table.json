    {"canonical": "ltda",     "forms": ["ltda", "limitada"],                                     "jurisdiction": "BR/CL",          "note": "Limited-liability company."},
    {"canonical": "sl",       "forms": ["sl", "sociedad limitada"],                              "jurisdiction": "ES",             "note": "Limited company."},
    {"canonical": "sadecv",   "forms": ["sa de cv", "sociedad anonima de capital variable", "sociedad anónima de capital variable"], "jurisdiction": "MX", "note": "'S.A. de C.V.' -> 'sa de cv' after R3."}
