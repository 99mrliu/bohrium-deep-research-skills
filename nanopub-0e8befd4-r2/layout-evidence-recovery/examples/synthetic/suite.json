        },
        {
          "id": "L02-fidelity-dehyphenation",
          "query": "cross-column order explicit",
          "mode": "fidelity",
          "expected_status": "matched",
          "expected_matches": 1,
          "expected": [{"page": 1, "block_id": "p1-left-intro", "line": 2, "line_offset_start": 0, "line_offset_end": 6, "document_char_start": 24, "document_char_end": 52, "segments": [{"page": 1, "block_id": "p1-left-intro", "line": 2, "line_offset_start": 0, "line_offset_end": 6}, {"page": 1, "block_id": "p1-left-intro", "line": 3, "line_offset_start": 0, "line_offset_end": 21}]}]
        },
        {
          "id": "L03-exact-does-not-fold-hyphen",
