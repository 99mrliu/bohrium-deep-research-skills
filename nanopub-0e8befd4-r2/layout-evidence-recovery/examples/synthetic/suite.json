          "expected_status": "not_found",
          "expected_matches": 0
        },
        {
          "id": "L04-exact-raw-newline-hyphen",
          "query": "cross-\ncolumn order explicit",
          "mode": "exact",
          "expected_status": "matched",
          "expected_matches": 1,
