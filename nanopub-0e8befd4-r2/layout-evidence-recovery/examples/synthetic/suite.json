          "id": "L25-dehyphenation-is-not-space-insertion",
          "query": "cross column",
          "mode": "fidelity",
          "expected_status": "not_found",
          "expected_matches": 0
        }
      ]
    },
    {
      "name": "form-feed-text",
      "input": "text.txt",
      "synthetic": true,
      "cases": [
        {
          "id": "T01-text-second-page",
          "query": "second page",
          "mode": "exact",
