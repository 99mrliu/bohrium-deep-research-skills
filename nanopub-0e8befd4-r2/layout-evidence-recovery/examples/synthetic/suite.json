{
  "suite_id": "SYNTHETIC-EVIDENCE-RECOVERY-TESTS",
  "synthetic": true,
  "formal_result": false,
  "groups": [
    {
      "name": "two-column-layout",
      "input": "layout.json",
      "synthetic": true,
      "cases": [
        {
          "id": "L01-exact-line-offset",
          "query": "Evidence recovery",
          "mode": "exact",
          "expected_status": "matched",
          "expected_matches": 1,
