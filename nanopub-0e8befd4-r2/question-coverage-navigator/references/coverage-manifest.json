  "evidence_derivation_key": "derivation",
  "evidence_rationale_key": "rationale",
  "source_id_key": "source_id",
  "source_uncertainty_key": "uncertainty",
  "required_question_keys": [
    "question_id",
    "question",
    "answer",
    "answer_mode",
    "status",
    "confidence",
    "progress_percent",
    "claim_ids",
    "evidence_ids",
